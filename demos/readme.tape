# Real Bubble Tea launcher, persona picker, and a shared three-persona conversation.
# Run just demo. No live microphone, playback, models, or personal config.
Output docs/images/tui.gif
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 18
Set Width 1120
Set Height 780
Set Padding 18
Set Framerate 20
Set TypingSpeed 35ms
Set Theme {"name":"termcast","background":"#0d0d11","foreground":"#f8f8f2","cursor":"#8BE9FD","selection":"#2a2a33","black":"#16161a","red":"#ff5f57","green":"#50fa7b","yellow":"#febc2e","blue":"#57a6ff","magenta":"#bd93f9","cyan":"#8be9fd","white":"#f8f8f2","brightBlack":"#6b7280","brightRed":"#ff6e67","brightGreen":"#69ff94","brightYellow":"#ffd23f","brightBlue":"#7ab8ff","brightMagenta":"#d0a9ff","brightCyan":"#a4f0ff","brightWhite":"#ffffff"}
Hide
Type "python3 demos/fixtures/readme.py" Enter
Sleep 3s
Show
Sleep 2s
Enter
Sleep 2s
Enter
Sleep 3s
Type "@obey Let's plan a weekend project."
Enter
Sleep 4s
Type "@jarvis What would you measure?"
Enter
Sleep 5s
Type "@veronica Keep us honest."
Enter
Sleep 5s
Type "@obey Can you see their ideas?"
Enter
Sleep 7s
Hide
Ctrl+C
Sleep 1s
Ctrl+C
Sleep 1s
