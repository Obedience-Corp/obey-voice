{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Obedience-Corp/obey-voice/docs/schemas/persona.schema.json",
  "title": "obey-voice.persona.v1",
  "description": "One voice agent persona: a name, prompt, brain-model, TTS overlay and optional native audio settings. Standard profiles inherit app STT, VAD, tools, skills, meeting and speaker settings. Kept in step with internal/persona.Profile by TestPersonaSchemaMatchesProfile.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "display_name",
    "prompts"
  ],
  "additionalProperties": false,
  "properties": {
    "participation_description": {"type":"string","maxLength":256,"description":"Optional public perspective description for group participation; not a permission or expertise claim."},
    "schema": {
      "const": "obey-voice.persona.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Kebab-case id. Must match the containing directory name and names the persona's prompt document."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Becomes agent_name when this persona is active."
    },
    "builtin": {
      "type": "boolean",
      "description": "True for shipped product personas (the YAML catalog under internal/persona/shipped/), which cannot be deleted."
    },
    "inactive": {
      "type": "boolean",
      "description": "When true, the persona remains saved but cannot be selected or used until enabled."
    },
    "brain": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-persona model routing. Empty fields inherit the app-level brain keys, so profiles written before this field existed behave exactly as before.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Brain backend (ollama, claude, cursor, grok). Empty keeps app-level brain_provider."
        },
        "model": {
          "type": "string",
          "description": "Provider-specific model id, routed to ollama_model, grok_model, or cursor_model. Claude has no app-level model key, so a persona-level Claude model is recorded but not routed."
        },
        "worker_tiers": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "additionalProperties": false,
          "properties": {
            "simple": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "assignment": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "endpoint_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "account_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "billing": {
                      "type": "string",
                      "enum": [
                        "local",
                        "subscription",
                        "metered",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "model",
                    "billing"
                  ]
                },
                "limits": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "runtime_seconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "model_requests": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "tool_calls": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "transport_retries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "charge_micro_usd": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "runtime_seconds",
                    "model_requests",
                    "tool_calls",
                    "transport_retries"
                  ]
                },
                "allow_uncapped": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "medium": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "assignment": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "endpoint_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "account_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "billing": {
                      "type": "string",
                      "enum": [
                        "local",
                        "subscription",
                        "metered",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "model",
                    "billing"
                  ]
                },
                "limits": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "runtime_seconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "model_requests": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "tool_calls": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "transport_retries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "charge_micro_usd": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "runtime_seconds",
                    "model_requests",
                    "tool_calls",
                    "transport_retries"
                  ]
                },
                "allow_uncapped": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "complex": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "assignment": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "endpoint_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "account_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "billing": {
                      "type": "string",
                      "enum": [
                        "local",
                        "subscription",
                        "metered",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "model",
                    "billing"
                  ]
                },
                "limits": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "runtime_seconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "model_requests": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "tool_calls": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "transport_retries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "charge_micro_usd": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "runtime_seconds",
                    "model_requests",
                    "tool_calls",
                    "transport_retries"
                  ]
                },
                "allow_uncapped": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "description": "Per-persona tier overrides in installation tiered mode. Omitted tiers/fields inherit Settings; assignment and limits replace whole groups. Installation policy cannot be overridden. Null restores inheritance."
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "description": "The model that runs spawned background jobs. Chosen alongside the brain: a persona that talks locally and works remotely is a deliberate choice. Empty fields inherit the app-level voice_worker_* keys.",
          "properties": {
            "provider": {
              "type": "string",
              "description": "Worker backend (ollama, grok, claude). Empty keeps app-level voice_worker_provider."
            },
            "model": {
              "type": "string",
              "description": "Model pin routed to voice_worker_model. Empty uses that provider's usual default."
            },
            "ollama_host": {
              "type": "string",
              "description": "Ollama base URL for the worker, routed to voice_worker_ollama_host. Empty inherits ollama_host."
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional native audio draft settings. Omission keeps Standard behavior. Native activation is unavailable until production input and transport bindings exist; candidate resolution is not a capability check.",
      "properties": {
        "mode": {"type": "string", "enum": ["", "standard", "native"], "description": "Empty or omitted means Standard; inactive native settings remain saved."},
        "provider": {"type": "string", "enum": ["", "ollama"], "description": "Native provider; empty or omitted means ollama."},
        "model": {"type": "string", "description": "Native model ID; empty or omitted means lfm3-audio:2b. Runtime capability checks are required before activation."},
        "endpoint": {"type": "string", "description": "HTTP(S) server origin with optional proxy prefix; omitted inherits ollama_host. Credentials, query strings, fragments and /api or /v1 suffixes are rejected."},
        "voice": {"type": "string", "description": "Model-specific native voice; empty means runtime default. Runtime validation is required; Standard voice catalogs do not apply."},
        "controls": {"type": "string", "enum": ["", "standard", "conversation"], "description": "Empty means standard. Standard controls require auto or required transcription. Conversation controls are incompatible with group participation."},
        "transcript": {"type": "string", "enum": ["", "auto", "required", "off"], "description": "Empty means auto. Off is invalid with active native Standard controls."},
        "retain_audio": {"type": "boolean", "description": "Persist input recordings; omitted means false."}
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-persona TTS backend and voice. provider selects the engine; voice is the speaker id for that engine (Kokoro name or Qwen preset).",
      "properties": {
        "provider": {
          "type": "string",
          "description": "TTS backend (e.g. kokoro, qwen3-tts). Empty keeps app-level tts_provider."
        },
        "voice": {
          "type": "string",
          "description": "Speaker id for the effective provider (Kokoro voice or Qwen CustomVoice preset)."
        },
        "tier": {
          "type": "string",
          "enum": [
            "",
            "0.6b",
            "1.7b"
          ],
          "description": "Native Qwen3-TTS model tier: 0.6b for latency, 1.7b for quality. Only read when the effective provider is qwen3-tts; empty inherits qwen_tts_model_tier. Canonicalized on persist, so 1.7 is stored as 1.7b."
        }
      }
    },
    "prompts": {
      "type": "object",
      "required": [
        "persona"
      ],
      "additionalProperties": false,
      "description": "Catalog refs for prompt documents. persona is the system identity; turn is an optional short per-reply voice instruction (empty = shared default). turn is not a conversation counter and is independent of tts.voice.",
      "properties": {
        "persona": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog name of the kind=persona system prompt. Usually the persona id (prompts/persona/<id>.yaml)."
        },
        "turn": {
          "type": "string",
          "description": "Optional catalog name of the kind=turn per-reply instruction. Empty uses the shared embedded default. Not the conversation turn counter; not a TTS voice id."
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional names that select this persona in a conversation."
    },
    "starting_directory": {
      "type": "string",
      "description": "Optional local starting directory for new conversations. Empty inherits the app default."
    }
  }
}
