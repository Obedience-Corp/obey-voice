{
  "schema": "obey-voice.benchmark.tts-rtf.v1",
  "id": "C1-coreml-code-predictor-0.6b",
  "question": "Does exporting the CoreML code predictor speed up qwen3-tts 0.6b on Apple Silicon, and by how much?",
  "measured_at": "2026-08-28T05:00:48Z",
  "machine": {
    "model_id": "Mac16,9",
    "cpu": "Apple M4 Max",
    "os": "macOS 26.5",
    "power": "AC; ollama unloaded and nothing else touching disk or GPU during either leg"
  },
  "what_changed": {
    "finding": "The engine looks for models/coreml/code_predictor.mlpackage and logs 'CoreML code predictor load failed: Model does not exist' on every start. The shipped native package does not include it, so every macOS install runs the ggml fallback.",
    "why_it_matters": "The code predictor sits inside the autoregressive loop, which F7's generate/decode split measured at 75-83% of synthesis cost and called the lever.",
    "export_command": "python scripts/convert_code_predictor_to_coreml.py --input models/Qwen3-TTS-12Hz-0.6B-Base --output <out>/coreml/code_predictor.mlpackage",
    "export_env": "isolated venv, coremltools 9.0, torch 2.13.0, python 3.12",
    "export_sanity": {
      "cosine_vs_torch": 0.999792,
