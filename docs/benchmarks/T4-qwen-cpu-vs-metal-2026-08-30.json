{
  "schema": "obey-voice.benchmark.tts-rtf.v1",
  "id": "T4-qwen-cpu-vs-metal",
  "title": "Qwen3-TTS 0.6b, CPU backend vs Metal backend, measured in the obey-voice pipeline",
  "question": "Does QWEN3_TTS_BACKEND=cpu sustain per-segment RTF below 1.0 on this Mac where the default Metal placement does not, and does RTF stay flat as the utterance gets longer?",
  "why_it_matters": "The qwen_tts_stream auto-gate streams only where streaming was measured not to break up: tts_place=lan, or a local package whose backend_hint is cuda. Metal at 0.6b measures ~1.30-1.36 RTF, which is why the local Metal case is excluded \u2014 a synthesizer slower than realtime underruns a streaming player. A prior unrecorded spot-check put the CPU backend near 0.80, which would clear that bar. This run checks it properly. It changes no gate and no default.",
  "measured_at": "2026-08-30T01:00:00Z",
  "machine": {
    "model_id": "Mac16,9",
    "cpu": "Apple M4 Max",
    "memory_bytes": 137438953472,
    "os": "macOS 26.5",
    "power": "AC. The two legs ran back to back with nothing else benchmarking; a long-running VM process was resident throughout both, equally."
  },
  "obey_voice": {
    "commit": "7d26f670ba00f5615a6e581bf9f8203440cd8df5",
    "branch": "bench/30b-rerun-cpu-tts",
    "worktree": "dirty \u2014 the B1e artifacts of this same PR were untracked at run time; no code differed from the commit",
    "binary": "./bin/obey-voice (just build)"
  },
  "engine": {
    "install": "~/.cache/festival-voice/models/qwen3-tts/install.json (qwen3-tts-native.install.v1)",
    "repo_commit": "135e01736401b6ae531e5b77fcb76100c9dc59de",
    "engine_sha": "22277bc6f087fd081df8bffa9c280b106a8af567",
    "worker": "bin/qwen3-tts-worker",
    "worker_sha256": "ebbe018e7e49549fd40150531481f25c9deeaabfa8eb39c2cdab7be8b397e5f4",
    "protocol": "qwen3-tts-worker/v1",
    "streaming": false,
    "sample_rate": 24000,
    "backend_hint_in_package": "metal",
    "tier": "0.6b",
    "model": "models/qwen3-tts-0.6b-f16.gguf",
    "model_sha256": "0b89770118463af8f2467d824a8de57d96df6a09f927a9769a3f7b7fffa7087d",
    "note": "Same engine_sha as F7, so the Metal leg here is directly comparable to F7's lab figure."
  },
  "method": {
    "harness": "cmd/obey-voice `benchmark --full-turn-fixture`, the committed per-segment TTS bench. Whole voice turns: capture -> VAD -> STT -> brain -> TTS -> playback, with events.SegmentMetric recorded per synthesized segment.",
    "rtf_definition": "SegmentMetric.RealtimeFactor() = EngineElapsed / AudioSeconds \u2014 synthesis alone. NOT SynthElapsed, which includes the queue wait behind an earlier sentence and would report a healthy engine as slow.",
    "warmup": "iteration 1 of 4 discarded on both legs (a cold worker pays 7-11s of model load on its first synthesis), matching cmd/tts-ab's -drop-warmup default. 3 iterations x 3 fixtures = 9 measured turns per leg.",
    "exclusions": "segments marked Fallback (Kokoro spoke them) or Interrupted, and any with AudioSeconds <= 0. None occurred: turns_with_fallback is 0 on both legs.",
    "fixtures": "3 synthetic long-reply fixtures, the SYNTH_TTS_TEXTS set from scripts/bench.sh, regenerated with cmd/golden-tts (kokoro af_heart, speed 0.95) plus 1.5s of ffmpeg apad \u2014 the same construction ensure_synth_fixtures performs. Written to a scratch directory via OBEY_VOICE_BENCH_FIXTURES so ~/.cache was not modified.",
    "brain": "qwen3.8-uncensored:27b via ollama, persona samantha (the live config). The brain decides the reply text, so segment texts differ between legs; RTF is normalized by audio duration and is bucketed by length below for exactly that reason.",
    "ordering": "Metal leg first, then the CPU leg, strictly serialized. Never concurrent.",
    "stat_note": "n=40 (Metal) and n=35 (CPU) segments. 'p95' is nearest-rank and at this n reads as the worst or near-worst observation, not a distributional claim."
  },
  "commands": [
    "just build",
    "# fixtures (mirrors scripts/bench.sh ensure_synth_fixtures, into a scratch dir)",
    "go build -o $SCRATCH/golden-tts ./cmd/golden-tts",
    "$SCRATCH/golden-tts -text \"<SYNTH_TTS_TEXTS[i]>\" -out $SCRATCH/raw-NN.wav",
    "ffmpeg -i $SCRATCH/raw-NN.wav -af apad=pad_dur=1.5 -c:a pcm_s16le -y $FIX/tts-NN.wav",
    "# Metal leg (default: QWEN3_TTS_BACKEND unset)",
    "./bin/obey-voice benchmark --iterations 4 --json-file $SCRATCH/t4-metal.json --tts-provider=qwen3-tts:0.6b --full-turn-fixture=$FIX/tts-01.wav --expect-text=... (x3)",
    "# CPU leg",
    "QWEN3_TTS_BACKEND=cpu ./bin/obey-voice benchmark --iterations 4 --json-file $SCRATCH/t4-cpu.json --tts-provider=qwen3-tts:0.6b --full-turn-fixture=$FIX/tts-01.wav --expect-text=... (x3)"
  ],
